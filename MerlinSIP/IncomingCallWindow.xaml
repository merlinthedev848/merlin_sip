<Window x:Class="MerlinSip.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming call"
        Icon="Assets/CKMedia-Icon.ico"
        Width="380"
        Height="230"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="18"
            Background="#FCFEFF"
            BorderBrush="#D8E1EE"
            BorderThickness="1"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="12" Opacity="0.22" Color="#07111E" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryGradientBrush}" DockPanel.Dock="Left" Margin="0,0,14,0">
                    <TextBlock Text="MS" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" Foreground="#07111E" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Incoming call" FontSize="20" FontWeight="Black" Foreground="#111827" />
                    <TextBlock Text="Merlin SIP" FontSize="13" FontWeight="Bold" Foreground="#667085" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="CallerNameText"
                           Text="Unknown caller"
                           FontSize="24"
                           FontWeight="Black"
                           Foreground="#0F8F78"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CallerNumberText"
                           Text=""
                           Margin="0,4,0,0"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#667085"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Answer"
                        Height="44"
                        Margin="0,0,8,0"
                        Background="{StaticResource PrimaryGradientBrush}"
                        Foreground="White"
                        Click="AnswerButton_Click" />
                <Button Grid.Column="1"
                        Content="Decline"
                        Height="44"
                        Margin="8,0,0,0"
                        Background="{StaticResource DangerGradientBrush}"
                        Foreground="White"
                        Click="DeclineButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
