<Window x:Class="MerlinSip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP"
        Width="1420"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        Background="#0D1421">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1421" Offset="0" />
            <GradientStop Color="#162033" Offset="0.48" />
            <GradientStop Color="#EAF0F7" Offset="0.49" />
            <GradientStop Color="#F6F9FC" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F8FBFF" Offset="0.44" />
            <GradientStop Color="#EAF1F8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DialFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#EAF2FA" Offset="0.55" />
            <GradientStop Color="#D9E5F1" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SideRailBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121B2B" Offset="0" />
            <GradientStop Color="#070C15" Offset="0.64" />
            <GradientStop Color="#030711" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27D5B7" Offset="0" />
            <GradientStop Color="#0E987E" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F16666" Offset="0" />
            <GradientStop Color="#C82F3A" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#DCE6F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="42" ShadowDepth="18" Opacity="0.24" Color="#07111E" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="{StaticResource DialFaceBrush}" />
            <Setter Property="BorderBrush" Value="#F9FCFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ShadowPlate" CornerRadius="8" Background="#9CB1C8" Margin="1,4,1,0" Opacity="0.26" />
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.22" Color="#07111E" />
                                </Border.Effect>
                                <Grid>
                                    <Border CornerRadius="7" BorderBrush="#FFFFFF" BorderThickness="1" Opacity="0.76" Margin="1" />
                                    <Border CornerRadius="7" Margin="3,3,3,29" Background="#66FFFFFF" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#07111E" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ShadowPlate" Property="Opacity" Value="0.08" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource DialButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ContactCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="#F9FCFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="6" Opacity="0.12" Color="#07111E" />
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="7" BorderBrush="#FFFFFF" BorderThickness="1" Opacity="0.72" Margin="0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#25BFA4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#E8F8F4" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#25BFA4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackdrop}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SideRailBrush}" Padding="16,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.34" Color="#020617" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="7" Opacity="0.28" Color="#020617" />
                        </Border.Effect>
                        <TextBlock Text="MS" Foreground="#07111E" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Merlin" Foreground="#FFFFFF" FontSize="13" FontWeight="Black" Margin="0,14,0,0" TextAlignment="Center" />
                    <TextBlock Text="SIP" Foreground="#8FA0B7" FontSize="10" TextAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,54,0,0">
                    <Button Content="Dial" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowDialButton_Click" />
                    <Button Content="Contacts" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowContactsButton_Click" />
                    <Button Content="Calls" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowCallsButton_Click" />
                    <Button Content="Settings" Style="{StaticResource SoftButton}" Click="OpenSettingsButton_Click" />
                </StackPanel>

                <TextBlock x:Name="LicenseStatusText"
                           DockPanel.Dock="Bottom"
                           Text="Trial mode"
                           Foreground="#8FA0B7"
                           FontSize="10"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <Border DockPanel.Dock="Right" x:Name="ConnectionPill" Background="#FFF1D6" CornerRadius="8" Padding="16,11">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.20" Color="#07111E" />
                    </Border.Effect>
                    <TextBlock x:Name="ConnectionStatusText" Text="Connecting..." Foreground="#8A4F08" FontWeight="Black" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Merlin SIP" Foreground="#F8FBFF" FontSize="34" FontWeight="Black" />
                    <TextBlock x:Name="NoticeText" Text="Registering your SIP account..." Foreground="#B7C5D8" FontSize="14" />
                </StackPanel>
            </DockPanel>

            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Phone">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="300" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,16">
                                    <Border DockPanel.Dock="Right" Background="#EAF3FF" CornerRadius="8" Padding="12,8">
                                        <TextBlock x:Name="CallStateText" Text="Ready" Foreground="#2750A7" FontWeight="Black" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Dial" Foreground="#64748B" FontWeight="Bold" />
                                        <TextBlock x:Name="DestinationPreviewText" Text="Enter number" Foreground="#111827" FontSize="34" FontWeight="Black" />
                                        <TextBlock x:Name="CallerLookupText" Text="No contact selected" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="94" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestinationTextBox" FontSize="18" Padding="14,12" BorderBrush="#D7E1EC" Background="#F9FBFE" TextChanged="DestinationTextBox_TextChanged" KeyDown="DestinationTextBox_KeyDown" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource SoftButton}" Click="ClearDestinationButton_Click" />
                                </Grid>

                                <UniformGrid Grid.Row="2" Columns="3" Rows="4" Margin="0,0,0,18" VerticalAlignment="Top">
                                    <Button Content="1" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="2" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="3" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="4" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="5" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="6" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="7" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="8" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="9" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="*" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="0" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="#" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                </UniformGrid>

                                <Grid Grid.Row="3" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Call" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="DialButton_Click" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="End" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="HangupButton_Click" />
                                </Grid>

                                <UniformGrid Grid.Row="4" Columns="3" Rows="2">
                                    <Button Content="Mute" Style="{StaticResource SoftButton}" Click="PlaceholderCallControl_Click" />
                                    <Button Content="Hold" Style="{StaticResource SoftButton}" Click="PlaceholderCallControl_Click" />
                                    <Button Content="Transfer" Style="{StaticResource SoftButton}" Click="PlaceholderCallControl_Click" />
                                    <Button Content="Park" Style="{StaticResource SoftButton}" Click="PlaceholderCallControl_Click" />
                                    <Button Content="DTMF" Style="{StaticResource SoftButton}" Click="PlaceholderCallControl_Click" />
                                    <Button Content="DND" Style="{StaticResource SoftButton}" Click="DndButton_Click" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="220" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,14">
                                        <Button DockPanel.Dock="Right" Content="Use selected" Style="{StaticResource SoftButton}" Width="130" Click="UseSelectedContactButton_Click" />
                                        <StackPanel>
                                            <TextBlock Text="Contacts" Foreground="#111827" FontSize="24" FontWeight="Black" />
                                            <TextBlock Text="Stored locally in JSON for quick dial and caller lookup." Foreground="#64748B" />
                                        </StackPanel>
                                    </DockPanel>
                                    <ListBox x:Name="ContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Background="#E8F8F4" CornerRadius="8" Padding="12,8">
                                                        <TextBlock Text="{Binding Number}" Foreground="#0E987E" FontWeight="Black" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="17" FontWeight="Black" />
                                                        <TextBlock Text="{Binding Company}" Foreground="#64748B" />
                                                        <TextBlock Text="{Binding Notes}" Foreground="#94A3B8" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Surface}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Add contact" Foreground="#111827" FontSize="22" FontWeight="Black" />
                                    <TextBlock Text="Name" Foreground="#64748B" FontWeight="Bold" Margin="0,16,0,4" />
                                    <TextBox x:Name="ContactNameTextBox" />
                                    <TextBlock Text="Number" Foreground="#64748B" FontWeight="Bold" Margin="0,12,0,4" />
                                    <TextBox x:Name="ContactNumberTextBox" />
                                    <TextBlock Text="Company" Foreground="#64748B" FontWeight="Bold" Margin="0,12,0,4" />
                                    <TextBox x:Name="ContactCompanyTextBox" />
                                    <TextBlock Text="Notes" Foreground="#64748B" FontWeight="Bold" Margin="0,12,0,4" />
                                    <TextBox x:Name="ContactNotesTextBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                                    <Button Content="Save contact" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,16,0,8" Click="SaveContactButton_Click" />
                                    <Button Content="Delete selected" Style="{StaticResource SoftButton}" Click="DeleteContactButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Surface}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="View all" Style="{StaticResource SoftButton}" Width="110" Click="ShowCallsButton_Click" />
                                        <TextBlock Text="Recent calls" Foreground="#111827" FontSize="22" FontWeight="Black" />
                                    </DockPanel>
                                    <ListBox x:Name="RecentCallsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" MouseDoubleClick="RecentCallsListView_MouseDoubleClick">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Width="250">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" Foreground="#2750A7" FontWeight="Black" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="Black" />
                                                        <TextBlock Text="{Binding Number}" Foreground="#64748B" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Calls">
                    <Border Style="{StaticResource Surface}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="Clear history" Style="{StaticResource SoftButton}" Width="130" Click="ClearHistoryButton_Click" />
                                <StackPanel>
                                    <TextBlock Text="Calls" FontSize="28" FontWeight="Black" Foreground="#111827" />
                                    <TextBlock Text="Local call history and signalling results." Foreground="#64748B" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="CallHistoryListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" MouseDoubleClick="CallHistoryListView_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#EEF4FB" CornerRadius="8" Padding="12,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="Black" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Duration}" Foreground="#64748B" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="17" FontWeight="Black" />
                                                <TextBlock Foreground="#64748B">
                                                    <Run Text="{Binding Direction}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Number}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding StartedAt}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" Foreground="#94A3B8" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#F9FCFF" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,18,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.14" Color="#07111E" />
                </Border.Effect>
                <TextBlock x:Name="FooterStatusText" Text="Ready." Foreground="#475569" FontWeight="Bold" />
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#9907111E">
            <Border Style="{StaticResource Surface}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SoftButton}" Width="90" Click="CloseSettingsButton_Click" />
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="28" FontWeight="Black" Foreground="#111827" />
                                <TextBlock Text="SIP account, devices, and cache." Foreground="#64748B" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="SIP server" Foreground="#64748B" FontWeight="Bold" />
                        <TextBox x:Name="ServerTextBox" Margin="0,5,0,12" />
                        <TextBlock Text="Port" Foreground="#64748B" FontWeight="Bold" />
                        <TextBox x:Name="PortTextBox" Margin="0,5,0,12" />
                        <TextBlock Text="Domain / realm" Foreground="#64748B" FontWeight="Bold" />
                        <TextBox x:Name="DomainTextBox" Margin="0,5,0,12" />
                        <TextBlock Text="Extension" Foreground="#64748B" FontWeight="Bold" />
                        <TextBox x:Name="ExtensionTextBox" Margin="0,5,0,12" />
                        <TextBlock Text="Auth username" Foreground="#64748B" FontWeight="Bold" />
                        <TextBox x:Name="UsernameTextBox" Margin="0,5,0,12" />
                        <TextBlock Text="Password" Foreground="#64748B" FontWeight="Bold" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,5,0,12" />

                        <TextBlock Text="Audio input" Foreground="#64748B" FontWeight="Bold" />
                        <ComboBox x:Name="AudioInputComboBox" Margin="0,5,0,12" />
                        <TextBlock Text="Audio output" Foreground="#64748B" FontWeight="Bold" />
                        <ComboBox x:Name="AudioOutputComboBox" Margin="0,5,0,12" />
                        <TextBlock Text="Video source" Foreground="#64748B" FontWeight="Bold" />
                        <ComboBox x:Name="VideoSourceComboBox" Margin="0,5,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Save and reconnect" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0" Click="ReconnectButton_Click" />
                            <Button Grid.Column="1" Content="Cache reset" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="ResetCacheButton_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
