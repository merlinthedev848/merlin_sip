<Window x:Class="MerlinSip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP"
        Icon="Assets/CKMedia-Icon.ico"
        Width="1420"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#0D1421">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FAFC" Offset="0" />
            <GradientStop Color="#EEF4F8" Offset="0.56" />
            <GradientStop Color="#FDFEFE" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F9FBFD" Offset="0.62" />
            <GradientStop Color="#F1F6FA" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DialFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F5F9FD" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SideRailBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121B2B" Offset="0" />
            <GradientStop Color="#070C15" Offset="0.64" />
            <GradientStop Color="#030711" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27D5B7" Offset="0" />
            <GradientStop Color="#0E987E" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F16666" Offset="0" />
            <GradientStop Color="#C82F3A" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#DCE6F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="10" Opacity="0.14" Color="#07111E" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="{StaticResource DialFaceBrush}" />
            <Setter Property="BorderBrush" Value="#D7E3EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.12" Color="#07111E" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#AFC2D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.10" Color="#07111E" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Background" Value="#EAF2FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource DialButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ContactCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="#F9FCFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.08" Color="#07111E" />
                            </Border.Effect>
                            <Grid>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#AFC2D8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#EEF4FB" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#8FB3D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackdrop}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SideRailBrush}" Padding="16,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.34" Color="#020617" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="7" Opacity="0.28" Color="#020617" />
                        </Border.Effect>
                        <TextBlock Text="MS" Foreground="#07111E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Merlin" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0" TextAlignment="Center" />
                    <TextBlock Text="SIP" Foreground="#8FA0B7" FontSize="10" TextAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,54,0,0">
                    <Button Content="Dial" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowDialButton_Click" />
                    <Button Content="Contacts" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowContactsButton_Click" />
                    <Button Content="Calls" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowCallsButton_Click" />
                    <Button Content="Messages" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowMessagesButton_Click" />
                    <Button Content="Settings" Style="{StaticResource SoftButton}" Click="OpenSettingsButton_Click" />
                </StackPanel>

                <TextBlock x:Name="LicenseStatusText"
                           DockPanel.Dock="Bottom"
                           Text="Licensed"
                           Foreground="#8FA0B7"
                           FontSize="10"
                           FontWeight="Medium"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Merlin SIP" Foreground="#111827" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock x:Name="NoticeText" Text="Ready." Foreground="#5D6B7C" FontSize="14" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        BorderBrush="#D7E1EC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.10" Color="#07111E" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search or dial"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 x:Name="GlobalSearchTextBox"
                                 Height="34"
                                 Padding="10,6"
                                 VerticalAlignment="Center"
                                 BorderBrush="#E2E8F0"
                                 Background="#F8FBFE"
                                 ToolTip="Type a number or contact name, then press Enter"
                                 TextChanged="GlobalSearchTextBox_TextChanged"
                                 KeyDown="GlobalSearchTextBox_KeyDown" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="#FFFFFF"
                            BorderBrush="#D7E1EC"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.10" Color="#07111E" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource PrimaryBrush}">
                                <TextBlock Text="MS" Foreground="#07111E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    x:Name="PresenceButton"
                                    Content="Available"
                                    Style="{StaticResource SoftButton}"
                                    Height="32"
                                    Click="PresenceButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Available" Click="PresenceMenuItem_Click" />
                                        <MenuItem Header="Busy" Click="PresenceMenuItem_Click" />
                                        <MenuItem Header="DND" Click="PresenceMenuItem_Click" />
                                        <MenuItem Header="Appear Away" Click="PresenceMenuItem_Click" />
                                        <MenuItem Header="Appear Offline" Click="PresenceMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                    <Border x:Name="MainConnectionPill" Background="#FFF1D6" CornerRadius="7" Padding="11,7" VerticalAlignment="Top">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.20" Color="#07111E" />
                        </Border.Effect>
                        <TextBlock x:Name="MainConnectionStatusText" Text="Checking" Foreground="#8A4F08" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>
                <TabItem x:Name="PhoneTab" Header="Phone">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="300" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,16">
                                    <Border DockPanel.Dock="Right"
                                            x:Name="CallTimerPill"
                                            Background="#FFE2E2"
                                            CornerRadius="7"
                                            Padding="9,5"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="CallTimerText" Text="Inactive" FontWeight="SemiBold" Foreground="#9B1C1C" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Dial" Foreground="#64748B" FontWeight="Medium" />
                                        <TextBlock x:Name="DestinationPreviewText" Text="Enter a number" Foreground="#111827" FontSize="30" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CallerLookupText" Text="No contact selected" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="94" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestinationTextBox" FontSize="18" Padding="14,12" BorderBrush="#D7E1EC" Background="#F9FBFE" TextChanged="DestinationTextBox_TextChanged" KeyDown="DestinationTextBox_KeyDown" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource SoftButton}" Click="ClearDestinationButton_Click" />
                                </Grid>

                                <UniformGrid Grid.Row="2" Columns="3" Rows="4" Margin="0,0,0,18" VerticalAlignment="Top">
                                    <Button Content="1" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="2" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="3" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="4" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="5" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="6" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="7" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="8" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="9" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="*" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="0" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="#" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                </UniformGrid>

                                <Grid Grid.Row="3" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="DialButton" Content="Call" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="DialButton_Click" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" x:Name="HangupButton" Content="End" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="HangupButton_Click" />
                                </Grid>

                                <UniformGrid Grid.Row="4" Columns="4" Rows="1">
                                    <Button x:Name="MuteButton" Content="Mute" Style="{StaticResource SoftButton}" Click="MuteButton_Click" />
                                    <Button x:Name="HoldButton" Content="Hold" Style="{StaticResource SoftButton}" Click="HoldButton_Click" />
                                    <Button x:Name="TransferButton" Content="Transfer" Style="{StaticResource SoftButton}" Click="TransferButton_Click" />
                                    <Button x:Name="DndButton" Content="DND" Style="{StaticResource SoftButton}" Click="DndButton_Click" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Directory" Foreground="#111827" FontSize="24" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid Grid.Row="1" Columns="2" HorizontalAlignment="Left" Width="260" Margin="0,0,0,12" VerticalAlignment="Top">
                                    <Button Content="History" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="ShowDirectoryHistoryButton_Click" />
                                    <Button Content="Contacts" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="ShowDirectoryContactsButton_Click" />
                                </UniformGrid>

                                <TabControl x:Name="DirectoryTabs" Grid.Row="1" Margin="0,54,0,0">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Style>
                                    </TabControl.Resources>
                                    <TabItem x:Name="DirectoryHistoryTab" Header="History">
                                        <ListBox x:Name="RecentCallsListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="RecentCallsListView_MouseDoubleClick">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Top" Background="#EAF1F8" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="95" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#475569" Margin="12,8" />
                                                            <TextBlock Grid.Column="1" Text="Number" FontWeight="SemiBold" Foreground="#475569" Margin="8" />
                                                            <TextBlock Grid.Column="2" Text="Duration" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="8" />
                                                            <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="8" />
                                                        </Grid>
                                                        <ScrollViewer Focusable="False">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,1" Background="#F8FBFE">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="95" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="12,10">
                                                            <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Direction}" Foreground="#64748B" FontSize="12" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#475569" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        <Border Grid.Column="3" Background="#EEF4FB" CornerRadius="6" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="SemiBold" FontSize="12" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>

                                    <TabItem x:Name="DirectoryContactsTab" Header="Contacts">
                                        <ListBox x:Name="DialContactsListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Top" Background="#EAF1F8" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="0.9*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#475569" Margin="12,8" />
                                                            <TextBlock Grid.Column="1" Text="Company" FontWeight="SemiBold" Foreground="#475569" Margin="8" />
                                                            <TextBlock Grid.Column="2" Text="Number" FontWeight="SemiBold" Foreground="#475569" Margin="8" />
                                                            <TextBlock Grid.Column="3" Text="BLF" FontWeight="SemiBold" Foreground="#475569" Margin="8" HorizontalAlignment="Center" />
                                                        </Grid>
                                                        <ScrollViewer Focusable="False">
                                                            <ItemsPresenter />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,1" Background="#F8FBFE">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" Margin="12,10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Company}" Foreground="#64748B" Margin="8,10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Number}" Foreground="#0E987E" FontWeight="SemiBold" Margin="8,10" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="3" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding PresenceLabel}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" FontSize="12" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ContactsTab" Header="Contacts">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.75*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Content="Call selected" Style="{StaticResource SoftButton}" Width="130" Click="UseSelectedContactButton_Click" />
                                    <StackPanel>
                                        <TextBlock Text="Contacts" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="PhonebookContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" SelectionChanged="PhonebookContactsListView_SelectionChanged" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="7,4" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Number}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Company}" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding Notes}" Foreground="#94A3B8" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <StackPanel>
                                <TextBlock Text="Contact details" Foreground="#111827" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Name" Foreground="#64748B" FontWeight="Medium" Margin="0,16,0,4" />
                                <TextBox x:Name="ContactNameTextBox" />
                                <TextBlock Text="Number" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNumberTextBox" />
                                <TextBlock Text="Company" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactCompanyTextBox" />
                                <TextBlock Text="Notes" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNotesTextBox" AcceptsReturn="True" Height="96" TextWrapping="Wrap" />
                                <Button Content="Save contact" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,18,0,10" Click="SaveContactButton_Click" />
                                <Button Content="Delete selected" Style="{StaticResource SoftButton}" Click="DeleteContactButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CallsTab" Header="Calls">
                    <Border Style="{StaticResource Surface}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="Clear history" Style="{StaticResource SoftButton}" Width="130" Click="ClearHistoryButton_Click" />
                                <StackPanel>
                                    <TextBlock Text="Calls" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="CallHistoryListView" Grid.Row="1" BorderThickness="0" Background="Transparent" MouseDoubleClick="CallHistoryListView_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,1" Background="#F8FBFE">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="12,10">
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Direction}" Foreground="#64748B" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#475569" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding StartedAt}" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <Border Grid.Column="4" Background="#EEF4FB" CornerRadius="6" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem x:Name="MessagesTab" Header="Messages">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right"
                                            Content="Clear chat"
                                            Style="{StaticResource SoftButton}"
                                            Background="{StaticResource DangerBrush}"
                                            Foreground="White"
                                            Width="92"
                                            Height="34"
                                            FontSize="12"
                                            Padding="8,0"
                                            Click="ClearChatThreadButton_Click" />
                                    <StackPanel>
                                        <TextBlock x:Name="ChatThreadTitleText" Text="Choose a conversation" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                        <TextBlock x:Name="ChatThreadSubtitleText" Text="" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="ChatMessagesListView" Grid.Row="1" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FBFE" BorderBrush="#EAF1F8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="#EEF4FB" CornerRadius="7" Padding="8,5">
                                                            <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="SemiBold" FontSize="12" />
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SentAt}" Foreground="#64748B" FontSize="12" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="#334155" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" Background="#F8FBFE" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MessageBodyTextBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="46"
                                                 MaxHeight="98"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="MessageBodyTextBox_KeyDown" />
                                        <Button Grid.Column="1"
                                                x:Name="SendMessageButton"
                                                Content="Send"
                                                Style="{StaticResource SoftButton}"
                                                Background="{StaticResource PrimaryBrush}"
                                                Foreground="White"
                                                Margin="10,0,0,0"
                                                Click="SendMessageButton_Click" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Conversations" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
                                </StackPanel>
                                <TextBox x:Name="MessageToTextBox" Visibility="Collapsed" />
                                <ListBox x:Name="ChatContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="ChatContactsListView_SelectionChanged" MouseDoubleClick="ChatContactsListView_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Background="#F8FBFE" Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="135" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" Margin="10,8" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="6,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding Number}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#F9FCFF" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,18,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.14" Color="#07111E" />
                </Border.Effect>
                <TextBlock x:Name="FooterStatusText" Text="Ready." Foreground="#475569" FontWeight="Medium" />
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#9907111E">
            <Border Style="{StaticResource Surface}" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SoftButton}" Width="90" Click="CloseSettingsButton_Click" />
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,18">
                            <Button Content="Account" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsAccountButton_Click" />
                            <Button Content="Preferences" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsPreferencesButton_Click" />
                            <Button Content="Handling" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsHandlingButton_Click" />
                            <Button Content="Devices" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsDevicesButton_Click" />
                            <Button Content="Queues" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsQueuesButton_Click" />
                            <Button Content="Advanced" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsAdvancedButton_Click" />
                            <Button Content="Status" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsStatusButton_Click" />
                            <Button Content="Updates" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsUpdatesButton_Click" />
                            <Button Content="About" Style="{StaticResource SoftButton}" Width="104" Margin="0,0,8,8" Click="SettingsAboutButton_Click" />
                        </WrapPanel>

                        <TabControl x:Name="SettingsTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TabControl.Resources>

                            <TabItem x:Name="SettingsAccountTab" Header="Account">
                                <StackPanel>
                                    <TextBlock Text="Provisioning code" Foreground="#64748B" FontWeight="Medium" />
                                    <Grid Margin="0,5,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 x:Name="SettingsProvisioningCodeTextBox"
                                                 MaxLength="8"
                                                 Margin="0,0,10,0" />
                                        <Button Grid.Column="1"
                                                x:Name="ProvisionAndReconnectButton"
                                                Content="Provision"
                                                Style="{StaticResource SoftButton}"
                                                Background="{StaticResource PrimaryBrush}"
                                                Foreground="White"
                                                Click="ProvisionAndReconnectButton_Click" />
                                    </Grid>

                                    <StackPanel x:Name="PrivatePbxSettingsPanel" Visibility="Collapsed">
                                        <TextBlock Text="PBX server" Foreground="#64748B" FontWeight="Medium" />
                                        <TextBox x:Name="PrivatePbxSettingsTextBox" Margin="0,5,0,12" />
                                    </StackPanel>

                                    <TextBlock Text="User / extension" Foreground="#64748B" FontWeight="Medium" />
                                    <TextBox x:Name="ExtensionTextBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Auth username" Foreground="#64748B" FontWeight="Medium" />
                                    <TextBox x:Name="UsernameTextBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Password" Foreground="#64748B" FontWeight="Medium" />
                                    <PasswordBox x:Name="PasswordBox" Margin="0,5,0,18" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Save and reconnect" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0" Click="ReconnectButton_Click" />
                                        <Button Grid.Column="1" Content="Reset app" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="ResetCacheButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsPreferencesTab" Header="Preferences">
                                <StackPanel>
                                    <TextBlock Text="Call Preferences" Foreground="#111827" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBlock Text="Mobile number" Foreground="#64748B" FontWeight="Medium" />
                                    <TextBox x:Name="MobileNumberTextBox" Margin="0,5,0,12" />
                                    <TextBlock Text="DND mode" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="DndModeComboBox" Margin="0,5,0,12">
                                        <ComboBoxItem Content="Off" />
                                        <ComboBoxItem Content="Reject calls" />
                                        <ComboBoxItem Content="Silent ringing" />
                                    </ComboBox>
                                    <TextBlock Text="When I decline a call" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="DeclineActionComboBox" Margin="0,5,0,12">
                                        <ComboBoxItem Content="Send busy" />
                                    </ComboBox>
                                    <CheckBox x:Name="CallWaitingCheckBox" Content="Allow call waiting while busy" Visibility="Collapsed" />
                                    <Button Content="Save preferences" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="SaveApplicationSettingsButton_Click" />
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsHandlingTab" Header="Handling">
                                <StackPanel>
                                    <TextBlock Text="Call Handling" Foreground="#111827" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBlock Text="Internal calls when busy" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="InternalBusyActionComboBox" Margin="0,5,0,12">
                                        <ComboBoxItem Content="Send busy" />
                                        <ComboBoxItem Content="Keep ringing" />
                                    </ComboBox>
                                    <TextBlock Text="Internal no-answer timeout" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="InternalNoAnswerTimeoutComboBox" Margin="0,5,0,12">
                                        <ComboBoxItem Content="30 seconds" />
                                        <ComboBoxItem Content="60 seconds" />
                                        <ComboBoxItem Content="90 seconds" />
                                    </ComboBox>
                                    <TextBlock Text="External calls when busy" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="ExternalBusyActionComboBox" Margin="0,5,0,12">
                                        <ComboBoxItem Content="Send busy" />
                                        <ComboBoxItem Content="Keep ringing" />
                                    </ComboBox>
                                    <TextBlock Text="External no-answer timeout" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="ExternalNoAnswerTimeoutComboBox" Margin="0,5,0,12">
                                        <ComboBoxItem Content="30 seconds" />
                                        <ComboBoxItem Content="60 seconds" />
                                        <ComboBoxItem Content="90 seconds" />
                                    </ComboBox>
                                    <Button Content="Save handling" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="SaveApplicationSettingsButton_Click" />
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsDevicesTab" Header="Devices">
                                <StackPanel>
                                    <TextBlock Text="Audio input" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="AudioInputComboBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Audio output" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="AudioOutputComboBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Ringtone" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="RingtoneComboBox" DisplayMemberPath="Name" Margin="0,5,0,12" />
                                    <Border Background="#EEF4FB" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Margin="0,0,0,12">
                                                <Button DockPanel.Dock="Right" Content="Test tone" Style="{StaticResource SoftButton}" Width="105" Click="TestToneButton_Click" />
                                                <TextBlock Text="Audio levels" Foreground="#111827" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Headphones" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" x:Name="HeadphoneVolumeSlider" Minimum="25" Maximum="200" TickFrequency="5" Value="100" ValueChanged="VolumeSlider_ValueChanged" />
                                                <TextBlock Grid.Column="2" x:Name="HeadphoneVolumeText" Text="100%" Foreground="#111827" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="125" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Microphone" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" x:Name="MicrophoneVolumeSlider" Minimum="25" Maximum="200" TickFrequency="5" Value="100" ValueChanged="VolumeSlider_ValueChanged" />
                                                <TextBlock Grid.Column="2" x:Name="MicrophoneVolumeText" Text="100%" Foreground="#111827" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Video source" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="VideoSourceComboBox" Margin="0,5,0,18" />
                                    <Button Content="Save devices" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="SaveDevicesButton_Click" />
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsQueuesTab" Header="Queues">
                                <StackPanel>
                                    <TextBlock Text="Queue Settings" Foreground="#111827" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <CheckBox x:Name="QueuePickupCheckBox" Content="Enable queue pickup shortcut" Foreground="#111827" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <TextBlock Text="Queue pickup dials *8 from this handset when enabled." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Pick up queue call" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="QueuePickupButton_Click" />
                                        <Button Grid.Column="1" Content="Save queues" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="SaveApplicationSettingsButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsAdvancedTab" Header="Advanced">
                                <StackPanel>
                                    <TextBlock Text="Advanced Settings" Foreground="#111827" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <CheckBox x:Name="FlashCallStateCheckBox" Content="Flash call state changes" Visibility="Collapsed" />
                                    <ComboBox x:Name="MaxCallsComboBox" Visibility="Collapsed">
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="3" />
                                    </ComboBox>
                                    <CheckBox x:Name="ShowCallStatsCheckBox" Content="Show call statistics" Visibility="Collapsed" />
                                    <CheckBox x:Name="SingleClickTransferCheckBox" Content="Single-click blind transfer" Visibility="Collapsed" />
                                    <CheckBox x:Name="CombineContactsCheckBox" Content="Combine contacts in search" Foreground="#111827" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <ComboBox x:Name="IncomingNotificationDurationComboBox" Visibility="Collapsed">
                                        <ComboBoxItem Content="15 seconds" />
                                        <ComboBoxItem Content="30 seconds" />
                                        <ComboBoxItem Content="60 seconds" />
                                    </ComboBox>
                                    <TextBlock Text="Failed call display timeout" Foreground="#64748B" FontWeight="Medium" />
                                    <ComboBox x:Name="FailedCallTimeoutComboBox" Margin="0,5,0,12">
                                        <ComboBoxItem Content="5 seconds" />
                                        <ComboBoxItem Content="10 seconds" />
                                        <ComboBoxItem Content="15 seconds" />
                                    </ComboBox>
                                    <CheckBox x:Name="FavouriteTransferCheckBox" Content="Show favourite extensions while transferring" Visibility="Collapsed" />
                                    <Button Content="Save advanced" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="SaveApplicationSettingsButton_Click" />
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsStatusTab" Header="Status">
                                <StackPanel>
                                    <Border Background="#EEF4FB" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" x:Name="ConnectionPill" Background="#FFF1D6" CornerRadius="7" Padding="9,5" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ConnectionStatusText" Text="Connecting..." Foreground="#8A4F08" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="Connection" Foreground="#111827" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="ServerStatusText" Text="Checking account connection." Foreground="#64748B" FontWeight="Medium" Margin="0,10,0,0" TextWrapping="Wrap" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Latency" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PingStatusText" Text="Not checked yet" Foreground="#111827" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AppVersionText" Text="-" Foreground="#111827" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Licensed to" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LicensedToText" Text="Checking" Foreground="#111827" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Product" Foreground="#64748B" FontWeight="Medium" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ProductIdText" Text="merlin-sip" Foreground="#111827" FontWeight="Medium" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FBFE" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource SoftButton}" Width="88" Click="SaveNetworkModeButton_Click" />
                                                <TextBlock Text="Connection assist" Foreground="#111827" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <CheckBox x:Name="SipAlgCompatibilityCheckBox"
                                                      Content="Router keepalive assist"
                                                      Foreground="#111827"
                                                      FontWeight="SemiBold"
                                                      Margin="0,12,0,4"
                                                      Checked="SipAlgCompatibilityCheckBox_Changed"
                                                      Unchecked="SipAlgCompatibilityCheckBox_Changed" />
                                            <TextBlock Text="Adds extra UDP keepalive traffic for difficult routers. Normal SIP registration is unchanged. Some ISP SIP ALG faults require a PBX-side TCP/TLS profile."
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="NAT keepalive" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NatKeepaliveStatusText" Text="Off" Foreground="#106247" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="rport signalling" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RportStatusText" Text="On" Foreground="#106247" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Auto recovery" Foreground="#64748B" FontWeight="Medium" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AutoRecoveryStatusText" Text="On" Foreground="#106247" FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8FBFE" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <Button DockPanel.Dock="Right"
                                                        x:Name="RunPbxDiagnosticsButton"
                                                        Content="Run test"
                                                        Style="{StaticResource SoftButton}"
                                                        Width="96"
                                                        Click="RunPbxDiagnosticsButton_Click" />
                                                <TextBlock Text="PBX diagnostics" Foreground="#111827" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="Checks registration, response time, messaging, audio packets, routing clues, and router compatibility."
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,12" />
                                            <TextBlock x:Name="PbxDiagnosticsText"
                                                       Text="Diagnostics have not been run yet."
                                                       Foreground="#334155"
                                                       FontWeight="Medium"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Send error log" Style="{StaticResource SoftButton}" Click="SendErrorLogButton_Click" />
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsUpdatesTab" Header="Updates">
                                <Border Background="#F8FBFE" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" x:Name="CheckUpdatesButton" Content="Check for updates" Style="{StaticResource SoftButton}" Width="150" Click="CheckUpdatesButton_Click" />
                                            <TextBlock Text="Updates" Foreground="#111827" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="UpdateStatusText" Text="Version checking" Foreground="#64748B" FontWeight="Medium" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="UpdateNotesText" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <TabItem x:Name="SettingsAboutTab" Header="About">
                                <StackPanel>
                                    <TextBlock Text="About Merlin SIP" Foreground="#111827" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBlock Text="CK Media Services softphone for managed SIP, messaging, contacts, and reception workflows." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ElementName=AppVersionText, Path=Text}" Foreground="#111827" FontWeight="Medium" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Product" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="merlin-sip" Foreground="#111827" FontWeight="Medium" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Support" Foreground="#64748B" FontWeight="Medium" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="CK Media Services" Foreground="#111827" FontWeight="Medium" />
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="IncomingCallOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#9907111E">
            <Border Style="{StaticResource Surface}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Incoming call" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock x:Name="IncomingCallerNameText" Text="Unknown caller" FontSize="22" FontWeight="SemiBold" Foreground="#0E987E" Margin="0,18,0,2" TextWrapping="Wrap" />
                    <TextBlock x:Name="IncomingCallerNumberText" Text="" FontSize="15" FontWeight="Medium" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="" Foreground="#64748B" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Answer" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0" Click="AnswerIncomingCallButton_Click" />
                        <Button Grid.Column="1" Content="Decline" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="DeclineIncomingCallButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
