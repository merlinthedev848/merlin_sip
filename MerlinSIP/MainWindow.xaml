                </TabItem>

                <TabItem x:Name="ContactsTab" Header="Contacts">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.75*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Content="Call selected" Style="{StaticResource SoftButton}" Width="130" Click="UseSelectedContactButton_Click" />
                                    <StackPanel>
                                        <TextBlock Text="Contacts" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="PhonebookContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" SelectionChanged="PhonebookContactsListView_SelectionChanged" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="7,4" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" Stroke="#111317" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding PresenceLabel}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Number}" Foreground="#D97706" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,2" />
                                                    <TextBlock Text="{Binding Company}" Foreground="#78716C" />
                                                    <TextBlock Text="{Binding Notes}" Foreground="#94A3B8" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <StackPanel>
                                <TextBlock Text="Contact details" Foreground="#111827" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Name" Foreground="#64748B" FontWeight="Medium" Margin="0,16,0,4" />
                                <TextBox x:Name="ContactNameTextBox" KeyDown="ContactTextBox_KeyDown" />
                                <TextBlock Text="Number" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNumberTextBox" KeyDown="ContactTextBox_KeyDown" />
                                <TextBlock Text="Company" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactCompanyTextBox" KeyDown="ContactTextBox_KeyDown" />
                                <TextBlock Text="Notes" Foreground="#64748B" FontWeight="Medium" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNotesTextBox" AcceptsReturn="True" Height="96" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <CheckBox x:Name="ContactIsFavoriteCheckBox" Content="Add to favorites / speed dial" Foreground="#111827" FontWeight="SemiBold" Margin="0,4,0,14" />
                                <Button Content="Save contact" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,0,10" Click="SaveContactButton_Click" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Delete selected" Style="{StaticResource SoftButton}" Click="DeleteContactButton_Click" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" x:Name="NewContactButton" Content="New / Clear" Style="{StaticResource SoftButton}" Click="NewContactButton_Click" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CallsTab" Header="Calls">
                    <Border Style="{StaticResource Surface}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="Clear history" Style="{StaticResource SoftButton}" Width="130" Click="ClearHistoryButton_Click" />
                                <StackPanel>
                                    <TextBlock Text="Calls" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="CallHistoryListView" Grid.Row="1" BorderThickness="0" Background="Transparent" MouseDoubleClick="CallHistoryListView_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Background="#EFECE6" Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#78716C" Margin="12,8" />
                                                <TextBlock Grid.Column="1" Text="Number" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                <TextBlock Grid.Column="2" Text="Date/Time" FontWeight="SemiBold" Foreground="#78716C" Margin="8" />
                                                <TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                                <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="#78716C" HorizontalAlignment="Center" Margin="8" />
                                            </Grid>
                                            <ScrollViewer Focusable="False">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,1" Background="#FDFBF7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="12,10">
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Direction}" Foreground="#78716C" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#78716C" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding StartedAt}" Foreground="#78716C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#78716C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <Border Grid.Column="4" Background="#EEF4FB" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem x:Name="MessagesTab" Header="Messages" Visibility="Collapsed">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right"
                                            Content="Clear chat"
                                            Style="{StaticResource SoftButton}"
                                            Background="{StaticResource DangerBrush}"
                                            Foreground="White"
                                            Width="92"
                                            Height="34"
                                            FontSize="12"
                                            Padding="8,0"
                                            Click="ClearChatThreadButton_Click" />
                                    <StackPanel>
                                        <TextBlock x:Name="ChatThreadTitleText" Text="Choose a conversation" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                                        <TextBlock x:Name="ChatThreadSubtitleText" Text="" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="ChatMessagesListView" Grid.Row="1" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FBFE" BorderBrush="#EAF1F8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Background="#F8FBFE" CornerRadius="7" Padding="8,5">
                                                            <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="SemiBold" FontSize="12" />
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SentAt}" Foreground="#64748B" FontSize="12" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="#334155" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" Background="#F8FBFE" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MessageBodyTextBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="46"
                                                 MaxHeight="98"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="MessageBodyTextBox_KeyDown" />
                                        <Button Grid.Column="1"
                                                x:Name="SendMessageButton"
                                                Content="Send"
                                                Style="{StaticResource SoftButton}"
                                                Background="{StaticResource PrimaryBrush}"
                                                Foreground="White"
                                                Margin="10,0,0,0"
                                                Click="SendMessageButton_Click" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Conversations" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
                                </StackPanel>
                                <TextBox x:Name="MessageToTextBox" Visibility="Collapsed" />
                                <ListBox x:Name="ChatContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="ChatContactsListView_SelectionChanged" MouseDoubleClick="ChatContactsListView_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Background="#F8FBFE" Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="135" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="SemiBold" Margin="10,8" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="{Binding PresenceBackground}" CornerRadius="6" Padding="6,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding Number}" Foreground="{Binding PresenceForeground}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border x:Name="FooterStatusBar" Grid.Row="2" Background="#FFF1D6" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,18,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.14" Color="#07111E" />
                </Border.Effect>
                <TextBlock x:Name="FooterStatusText" Text="Checking account connection" Foreground="#8A4F08" FontWeight="Medium" />
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#D9000000">
            <Border Style="{StaticResource Surface}" Width="780" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Panel -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" CornerRadius="8,0,0,8" Padding="16,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!-- Title -->
                            <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,24" />
                            
                            <!-- Sidebar Tabs -->
                            <StackPanel Grid.Row="1">
                                <Button x:Name="TabBtnGeneral" Content="General" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsGeneralButton_Click" Margin="0,0,0,6" />
                                <Button x:Name="TabBtnAccount" Content="Account" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsAccountButton_Click" Margin="0,0,0,6" />
                                <Button x:Name="TabBtnHandling" Content="Call routing" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsHandlingButton_Click" Margin="0,0,0,6" />
                                <Button x:Name="TabBtnAudio" Content="Audio" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsAudioButton_Click" Margin="0,0,0,6" />
                                <Button x:Name="TabBtnDiagnostics" Content="Diagnostics" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsDiagnosticsButton_Click" Margin="0,0,0,6" />
                                <Button x:Name="TabBtnAbout" Content="About" Style="{StaticResource SettingsTabButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsAboutButton_Click" Margin="0,0,0,6" />
                            </StackPanel>

                            <!-- Close Button -->
                            <Button Grid.Row="2" Content="Close" Style="{StaticResource SoftButton}" HorizontalAlignment="Stretch" Click="CloseSettingsButton_Click" />
                        </Grid>
                    </Border>

                    <!-- Settings Content Panel -->
                    <Grid Grid.Column="1" Margin="20,20,12,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TabControl Grid.Row="0" x:Name="SettingsTabs" Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                                
                                <!-- Compact Corporate styles for settings controls -->
                                <Style TargetType="TextBox">
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="Padding" Value="6,1" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="Padding" Value="6,1" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="MinHeight" Value="26" />
                                    <Setter Property="Padding" Value="6,1,28,1" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="MaxDropDownHeight" Value="180" />
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="Margin" Value="0,0,0,3" />
                                </Style>
                                <Style x:Key="SettingsCard" TargetType="Border">
                                    <Setter Property="Padding" Value="12" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                                <Style TargetType="Slider">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </TabControl.Resources>

                            <!-- Tab 1: General Preferences -->
                            <TabItem x:Name="SettingsGeneralTab" Header="General">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Call preferences" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Do not disturb" />
                                                    <ComboBox x:Name="DndModeComboBox" Margin="0,0,0,4">
                                                        <ComboBoxItem Content="Off" />
                                                        <ComboBoxItem Content="Reject calls" />
                                                        <ComboBoxItem Content="Silent ringing" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="When I decline a call" />
                                                    <ComboBox x:Name="DeclineActionComboBox" Margin="0,0,0,4">
                                                        <ComboBoxItem Content="Send busy" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Queue pickup" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <CheckBox x:Name="QueuePickupCheckBox" Content="Enable queue pickup shortcut" FontWeight="SemiBold" />
                                            <DockPanel Margin="0,4,0,0">
                                                <Button DockPanel.Dock="Right" Content="Pick up queue call" Style="{StaticResource SoftButton}" Height="28" Width="140" Click="QueuePickupButton_Click" />
                                                <TextBlock Text="Uses *8 from this handset when queue pickup is enabled." Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Search and display" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <CheckBox x:Name="CombineContactsCheckBox" Content="Combine contacts in search" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBlock Text="Failed call message duration" />
                                            <ComboBox x:Name="FailedCallTimeoutComboBox" Margin="0,0,0,4">
                                                <ComboBoxItem Content="5 seconds" />
                                                <ComboBoxItem Content="10 seconds" />
                                                <ComboBoxItem Content="15 seconds" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- Tab 2: Account Connection -->
                            <TabItem x:Name="SettingsAccountTab" Header="Account">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Account setup" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBlock Text="Setup code" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         x:Name="SettingsProvisioningCodeTextBox"
                                                         MaxLength="8"
                                                         Margin="0,0,8,0" />
                                                <Button Grid.Column="1"
                                                        x:Name="ProvisionAndReconnectButton"
                                                        Content="Apply code"
                                                        Style="{StaticResource SoftButton}"
                                                        Height="26"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        Foreground="White"
                                                        Click="ProvisionAndReconnectButton_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Account credentials" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            
                                            <StackPanel x:Name="PrivatePbxSettingsPanel" Visibility="Collapsed">
                                                <TextBlock Text="SIP server" />
                                                <TextBox x:Name="PrivatePbxSettingsTextBox" />
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Extension or user ID" />
                                                    <TextBox x:Name="ExtensionTextBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Authentication username" />
                                                    <TextBox x:Name="UsernameTextBox" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Password" />
                                            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,4" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Connection settings" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Signalling mode" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" x:Name="SipTransportModeComboBox" Height="26" VerticalContentAlignment="Center" SelectionChanged="SipTransportModeComboBox_SelectionChanged" Margin="0,0,0,6">
                                                    <ComboBoxItem Content="Standard UDP" Tag="UDP" />
                                                    <ComboBoxItem Content="TCP signalling" Tag="TCP" />
                                                    <ComboBoxItem Content="Encrypted TLS" Tag="TLS" />
                                                </ComboBox>
                                            </Grid>

                                            <CheckBox x:Name="SipAlgCompatibilityCheckBox"
                                                      Content="Router keepalive assist"
                                                      FontWeight="SemiBold"
                                                      Margin="0,4,0,6"
                                                      Checked="SipAlgCompatibilityCheckBox_Changed"
                                                      Unchecked="SipAlgCompatibilityCheckBox_Changed" />

                                            <CheckBox x:Name="IgnoreSslErrorsCheckBox"
                                                      Content="Ignore licensing SSL/TLS validation errors"
                                                      FontWeight="SemiBold"
                                                      Margin="0,4,0,6"
                                                      Checked="IgnoreSslErrorsCheckBox_Changed"
                                                      Unchecked="IgnoreSslErrorsCheckBox_Changed" />

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="NAT Keepalive: " Foreground="#64748B" />
                                                    <TextBlock x:Name="NatKeepaliveStatusText" Text="Off" Foreground="#106247" FontWeight="Bold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="rport: " Foreground="#64748B" />
                                                    <TextBlock x:Name="RportStatusText" Text="On" Foreground="#106247" FontWeight="Bold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="Recovery: " Foreground="#64748B" />
                                                    <TextBlock x:Name="AutoRecoveryStatusText" Text="On" Foreground="#106247" FontWeight="Bold" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- Tab 3: Call Routing -->
                            <TabItem x:Name="SettingsHandlingTab" Header="Routing">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Call forwarding" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBlock Text="Mobile number for diverted calls" />
                                            <TextBox x:Name="MobileNumberTextBox" Margin="0,0,0,4" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Routing and timeouts" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            
                                            <TextBlock Text="Internal calls" Foreground="#0E987E" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Action when busy" />
                                                    <ComboBox x:Name="InternalBusyActionComboBox">
                                                        <ComboBoxItem Content="Send busy" />
                                                        <ComboBoxItem Content="Keep ringing" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="No-answer timeout" />
                                                    <ComboBox x:Name="InternalNoAnswerTimeoutComboBox">
                                                        <ComboBoxItem Content="30 seconds" />
                                                        <ComboBoxItem Content="60 seconds" />
                                                        <ComboBoxItem Content="90 seconds" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <TextBlock Text="External calls" Foreground="#0E987E" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,6" />
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Action when busy" />
                                                    <ComboBox x:Name="ExternalBusyActionComboBox">
                                                        <ComboBoxItem Content="Send busy" />
                                                        <ComboBoxItem Content="Keep ringing" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="No-answer timeout" />
                                                    <ComboBox x:Name="ExternalNoAnswerTimeoutComboBox">
                                                        <ComboBoxItem Content="30 seconds" />
                                                        <ComboBoxItem Content="60 seconds" />
                                                        <ComboBoxItem Content="90 seconds" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Feature codes" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Call pickup prefix" />
                                                    <TextBox x:Name="CallPickupPrefixTextBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="Queue login/logout" />
                                                    <TextBox x:Name="QueueToggleCodeTextBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="Call recording" />
                                                    <TextBox x:Name="CallRecordingCodeTextBox" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- Tab 4: Audio & Media -->
                            <TabItem x:Name="SettingsAudioTab" Header="Audio">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Audio devices" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Audio input" />
                                                    <ComboBox x:Name="AudioInputComboBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Audio output" />
                                                    <ComboBox x:Name="AudioOutputComboBox" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Ringtone" />
                                            <ComboBox x:Name="RingtoneComboBox" DisplayMemberPath="Name" Margin="0,0,0,4" />
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <Button DockPanel.Dock="Right" Content="Test tone" Style="{StaticResource SoftButton}" Height="28" Width="105" Click="TestToneButton_Click" />
                                                <TextBlock Text="Audio levels" Foreground="#111827" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="45" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Headphones" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" x:Name="HeadphoneVolumeSlider" Minimum="25" Maximum="200" TickFrequency="5" Value="100" ValueChanged="VolumeSlider_ValueChanged" />
                                                <TextBlock Grid.Column="2" x:Name="HeadphoneVolumeText" Text="100%" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="45" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Microphone" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" x:Name="MicrophoneVolumeSlider" Minimum="25" Maximum="200" TickFrequency="5" Value="100" ValueChanged="VolumeSlider_ValueChanged" />
                                                <TextBlock Grid.Column="2" x:Name="MicrophoneVolumeText" Text="100%" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- Tab 5: Diagnostics & Updates -->
                            <TabItem x:Name="SettingsDiagnosticsTab" Header="Diagnostics">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" x:Name="RunPbxDiagnosticsButton" Content="Run test" Style="{StaticResource SoftButton}" Height="28" Width="96" Click="RunPbxDiagnosticsButton_Click" />
                                                <TextBlock Text="Network Diagnostics" Foreground="#111827" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="PbxDiagnosticsText" Text="No diagnostic test has been run yet." Foreground="#334155" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" x:Name="CheckUpdatesButton" Content="Check updates" Style="{StaticResource SoftButton}" Height="28" Width="110" Click="CheckUpdatesButton_Click" />
                                                <TextBlock Text="Software updates" Foreground="#111827" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="UpdateStatusText" Text="Checking for updates" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="UpdateNotesText" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="Support" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Send diagnostic log" Style="{StaticResource SoftButton}" Height="28" Margin="0,0,4,0" Click="SendErrorLogButton_Click" />
                                                <Button Grid.Column="1" Content="Reset application" Style="{StaticResource SoftButton}" Height="28" Background="{StaticResource DangerBrush}" Foreground="White" Margin="4,0,0,0" Click="ResetCacheButton_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- Tab 6: About -->
                            <TabItem x:Name="SettingsAboutTab" Header="About">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="About Merlin SIP" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBlock Text="Business SIP client for managed calling, messaging, contacts, and reception workflows." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10" />
                                            
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutVersionText" Text="1.2.0" Foreground="#111827" Margin="0,0,0,4" />
                                                
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Product" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProductIdText" Text="merlin-sip" Foreground="#111827" Margin="0,0,0,4" />
                                                
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Licensed to" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LicensedToText" Text="Checking" Foreground="#111827" Margin="0,0,0,4" />
                                                
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Support" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="CK Media Services" Foreground="#111827" Margin="0,0,0,4" />
                                                
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Connection" Foreground="#64748B" />
                                                <DockPanel Grid.Row="4" Grid.Column="1">
                                                    <Border x:Name="ConnectionPill" Background="#FFF1D6" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0">
                                                        <TextBlock x:Name="ConnectionStatusText" Text="Connecting..." Foreground="#8A4F08" FontWeight="SemiBold" FontSize="10" Margin="0" />
                                                    </Border>
                                                    <TextBlock x:Name="ServerStatusText" Text="Checking status" Foreground="#64748B" VerticalAlignment="Center" Margin="0" />
                                                </DockPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Style="{StaticResource SettingsCard}">
                                        <StackPanel>
                                            <TextBlock Text="System Metrics" Foreground="#111827" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Latency" Foreground="#64748B" />
                                                <TextBlock Grid.Column="1" x:Name="PingStatusText" Text="Not checked yet" Foreground="#111827" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                            <!-- Unified Action Buttons -->
                            <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource SoftButton}" Width="100" Margin="0,0,10,0" Click="CloseSettingsButton_Click" />
                                    <Button Content="Save Changes" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Width="130" Click="SaveAllSettingsButton_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        <Grid x:Name="IncomingCallOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#9907111E">
            <Border Style="{StaticResource Surface}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Incoming call" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock x:Name="IncomingCallerNameText" Text="Unknown caller" FontSize="22" FontWeight="SemiBold" Foreground="#0E987E" Margin="0,18,0,2" TextWrapping="Wrap" />
                    <TextBlock x:Name="IncomingCallerNumberText" Text="" FontSize="15" FontWeight="Medium" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="" Foreground="#64748B" Margin="0,8,0,10" TextWrapping="Wrap" />
                    <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Answer" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0" Click="AnswerIncomingCallButton_Click" />
                        <Button Grid.Column="1" Content="Decline" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="DeclineIncomingCallButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
