<Window x:Class="MerlinSip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP"
        Icon="Assets/CKMedia-Icon.ico"
        Width="1420"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#0D1421">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101827" Offset="0" />
            <GradientStop Color="#172033" Offset="0.44" />
            <GradientStop Color="#EDF3F8" Offset="0.45" />
            <GradientStop Color="#F7FAFD" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F9FBFD" Offset="0.62" />
            <GradientStop Color="#F1F6FA" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DialFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F5F9FD" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SideRailBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121B2B" Offset="0" />
            <GradientStop Color="#070C15" Offset="0.64" />
            <GradientStop Color="#030711" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27D5B7" Offset="0" />
            <GradientStop Color="#0E987E" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F16666" Offset="0" />
            <GradientStop Color="#C82F3A" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#DCE6F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="10" Opacity="0.14" Color="#07111E" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="{StaticResource DialFaceBrush}" />
            <Setter Property="BorderBrush" Value="#D7E3EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.12" Color="#07111E" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#AFC2D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.10" Color="#07111E" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Background" Value="#EAF2FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource DialButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ContactCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="#F9FCFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.08" Color="#07111E" />
                            </Border.Effect>
                            <Grid>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#25BFA4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#E8F8F4" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#25BFA4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackdrop}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SideRailBrush}" Padding="16,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.34" Color="#020617" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="7" Opacity="0.28" Color="#020617" />
                        </Border.Effect>
                        <TextBlock Text="MS" Foreground="#07111E" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Merlin" Foreground="#FFFFFF" FontSize="13" FontWeight="Black" Margin="0,14,0,0" TextAlignment="Center" />
                    <TextBlock Text="SIP" Foreground="#8FA0B7" FontSize="10" TextAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,54,0,0">
                    <Button Content="Dial" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowDialButton_Click" />
                    <Button Content="Contacts" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowContactsButton_Click" />
                    <Button Content="Calls" Style="{StaticResource SoftButton}" Margin="0,0,0,12" Click="ShowCallsButton_Click" />
                    <Button Content="Settings" Style="{StaticResource SoftButton}" Click="OpenSettingsButton_Click" />
                </StackPanel>

                <TextBlock x:Name="LicenseStatusText"
                           DockPanel.Dock="Bottom"
                           Text="Licensed"
                           Foreground="#8FA0B7"
                           FontSize="10"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <Border DockPanel.Dock="Right" x:Name="MainConnectionPill" Background="#FFF1D6" CornerRadius="8" Padding="16,11">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.20" Color="#07111E" />
                    </Border.Effect>
                    <TextBlock x:Name="MainConnectionStatusText" Text="Checking" Foreground="#8A4F08" FontWeight="Black" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Merlin SIP" Foreground="#F8FBFF" FontSize="34" FontWeight="Black" />
                    <TextBlock x:Name="NoticeText" Text="Dial, contacts, and call history." Foreground="#B7C5D8" FontSize="14" />
                </StackPanel>
            </DockPanel>

            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>
                <TabItem x:Name="PhoneTab" Header="Phone">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="300" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="0,0,0,16">
                                    <Border DockPanel.Dock="Right"
                                            x:Name="CallTimerPill"
                                            Background="#FFE2E2"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="CallTimerText" Text="Inactive" FontWeight="Black" Foreground="#9B1C1C" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Dial" Foreground="#64748B" FontWeight="Bold" />
                                        <TextBlock x:Name="DestinationPreviewText" Text="Enter number" Foreground="#111827" FontSize="34" FontWeight="Black" />
                                        <TextBlock x:Name="CallerLookupText" Text="No contact selected" Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="94" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestinationTextBox" FontSize="18" Padding="14,12" BorderBrush="#D7E1EC" Background="#F9FBFE" TextChanged="DestinationTextBox_TextChanged" KeyDown="DestinationTextBox_KeyDown" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource SoftButton}" Click="ClearDestinationButton_Click" />
                                </Grid>

                                <UniformGrid Grid.Row="2" Columns="3" Rows="4" Margin="0,0,0,18" VerticalAlignment="Top">
                                    <Button Content="1" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="2" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="3" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="4" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="5" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="6" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="7" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="8" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="9" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="*" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="0" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                    <Button Content="#" Style="{StaticResource DialButton}" Click="DialpadButton_Click" />
                                </UniformGrid>

                                <Grid Grid.Row="3" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="DialButton" Content="Call" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="DialButton_Click" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" x:Name="HangupButton" Content="End" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="HangupButton_Click" />
                                </Grid>

                                <UniformGrid Grid.Row="4" Columns="4" Rows="1">
                                    <Button x:Name="MuteButton" Content="Mute" Style="{StaticResource SoftButton}" Click="MuteButton_Click" />
                                    <Button x:Name="HoldButton" Content="Hold" Style="{StaticResource SoftButton}" Click="HoldButton_Click" />
                                    <Button x:Name="TransferButton" Content="Transfer" Style="{StaticResource SoftButton}" Click="TransferButton_Click" />
                                    <Button x:Name="DndButton" Content="DND" Style="{StaticResource SoftButton}" Click="DndButton_Click" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Open full view" Style="{StaticResource SoftButton}" Width="130" Click="ShowCallsButton_Click" />
                                    <StackPanel>
                                        <TextBlock Text="Quick access" Foreground="#111827" FontSize="24" FontWeight="Black" />
                                        <TextBlock Text="Double-click to call." Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>

                                <TabControl Grid.Row="1">
                                    <TabItem Header="Recent calls">
                                        <ListBox x:Name="RecentCallsListView" BorderThickness="0" Background="Transparent" MouseDoubleClick="RecentCallsListView_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,1" Background="#F8FBFE">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.3*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="80" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="12,10">
                                                            <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="Black" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Direction}" Foreground="#64748B" FontSize="12" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#475569" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        <Border Grid.Column="3" Background="#EEF4FB" CornerRadius="7" Padding="8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="Black" FontSize="12" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>

                                    <TabItem Header="Contacts">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ListBox x:Name="DialContactsListView" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Background="#E8F8F4" CornerRadius="8" Padding="12,8">
                                                                <TextBlock Text="{Binding Number}" Foreground="#0E987E" FontWeight="Black" />
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="17" FontWeight="Black" />
                                                                <TextBlock Text="{Binding Company}" Foreground="#64748B" />
                                                                <TextBlock Text="{Binding Notes}" Foreground="#94A3B8" FontSize="12" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Grid.Row="1" Content="Use selected" Style="{StaticResource SoftButton}" Margin="0,12,0,0" Click="UseSelectedContactButton_Click" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ContactsTab" Header="Contacts">
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.75*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Content="Call selected" Style="{StaticResource SoftButton}" Width="130" Click="UseSelectedContactButton_Click" />
                                    <StackPanel>
                                        <TextBlock Text="Phonebook" FontSize="28" FontWeight="Black" Foreground="#111827" />
                                        <TextBlock Text="Manage saved contacts." Foreground="#64748B" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="PhonebookContactsListView" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ContactCard}" SelectionChanged="PhonebookContactsListView_SelectionChanged" MouseDoubleClick="ContactsListView_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="#E8F8F4" CornerRadius="8" Padding="12,8">
                                                    <TextBlock Text="{Binding Number}" Foreground="#0E987E" FontWeight="Black" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="17" FontWeight="Black" />
                                                    <TextBlock Text="{Binding Company}" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding Notes}" Foreground="#94A3B8" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Surface}">
                            <StackPanel>
                                <TextBlock Text="Add contact" Foreground="#111827" FontSize="24" FontWeight="Black" />
                                <TextBlock Text="Name" Foreground="#64748B" FontWeight="Bold" Margin="0,16,0,4" />
                                <TextBox x:Name="ContactNameTextBox" />
                                <TextBlock Text="Number" Foreground="#64748B" FontWeight="Bold" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNumberTextBox" />
                                <TextBlock Text="Company" Foreground="#64748B" FontWeight="Bold" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactCompanyTextBox" />
                                <TextBlock Text="Notes" Foreground="#64748B" FontWeight="Bold" Margin="0,12,0,4" />
                                <TextBox x:Name="ContactNotesTextBox" AcceptsReturn="True" Height="96" TextWrapping="Wrap" />
                                <Button Content="Save contact" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,18,0,10" Click="SaveContactButton_Click" />
                                <Button Content="Delete selected" Style="{StaticResource SoftButton}" Click="DeleteContactButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="CallsTab" Header="Calls">
                    <Border Style="{StaticResource Surface}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="Clear history" Style="{StaticResource SoftButton}" Width="130" Click="ClearHistoryButton_Click" />
                                <StackPanel>
                                    <TextBlock Text="Calls" FontSize="28" FontWeight="Black" Foreground="#111827" />
                                    <TextBlock Text="Call history." Foreground="#64748B" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="CallHistoryListView" Grid.Row="1" BorderThickness="0" Background="Transparent" MouseDoubleClick="CallHistoryListView_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,1" Background="#F8FBFE">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="12,10">
                                                <TextBlock Text="{Binding Name}" Foreground="#111827" FontSize="15" FontWeight="Black" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Direction}" Foreground="#64748B" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#475569" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding StartedAt}" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <Border Grid.Column="4" Background="#EEF4FB" CornerRadius="7" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Result}" Foreground="#2750A7" FontWeight="Black" FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#F9FCFF" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,18,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.14" Color="#07111E" />
                </Border.Effect>
                <TextBlock x:Name="FooterStatusText" Text="Ready." Foreground="#475569" FontWeight="Bold" />
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#9907111E">
            <Border Style="{StaticResource Surface}" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SoftButton}" Width="90" Click="CloseSettingsButton_Click" />
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="28" FontWeight="Black" Foreground="#111827" />
                                <TextBlock Text="Account and devices." Foreground="#64748B" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                            <Button Content="Account" Style="{StaticResource SoftButton}" Click="SettingsAccountButton_Click" />
                            <Button Content="Devices" Style="{StaticResource SoftButton}" Click="SettingsDevicesButton_Click" />
                            <Button Content="Status" Style="{StaticResource SoftButton}" Click="SettingsStatusButton_Click" />
                            <Button Content="Updates" Style="{StaticResource SoftButton}" Click="SettingsUpdatesButton_Click" />
                        </UniformGrid>

                        <TabControl x:Name="SettingsTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TabControl.Resources>

                            <TabItem x:Name="SettingsAccountTab" Header="Account">
                                <StackPanel>
                                    <TextBlock Text="Provisioning code" Foreground="#64748B" FontWeight="Bold" />
                                    <Grid Margin="0,5,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 x:Name="SettingsProvisioningCodeTextBox"
                                                 MaxLength="8"
                                                 Margin="0,0,10,0" />
                                        <Button Grid.Column="1"
                                                x:Name="ProvisionAndReconnectButton"
                                                Content="Provision"
                                                Style="{StaticResource SoftButton}"
                                                Background="{StaticResource PrimaryBrush}"
                                                Foreground="White"
                                                Click="ProvisionAndReconnectButton_Click" />
                                    </Grid>

                                    <TextBlock Text="User / extension" Foreground="#64748B" FontWeight="Bold" />
                                    <TextBox x:Name="ExtensionTextBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Auth username" Foreground="#64748B" FontWeight="Bold" />
                                    <TextBox x:Name="UsernameTextBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Password" Foreground="#64748B" FontWeight="Bold" />
                                    <PasswordBox x:Name="PasswordBox" Margin="0,5,0,18" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Save and reconnect" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0" Click="ReconnectButton_Click" />
                                        <Button Grid.Column="1" Content="Reset app" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="ResetCacheButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsDevicesTab" Header="Devices">
                                <StackPanel>
                                    <TextBlock Text="Audio input" Foreground="#64748B" FontWeight="Bold" />
                                    <ComboBox x:Name="AudioInputComboBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Audio output" Foreground="#64748B" FontWeight="Bold" />
                                    <ComboBox x:Name="AudioOutputComboBox" Margin="0,5,0,12" />
                                    <TextBlock Text="Ringtone" Foreground="#64748B" FontWeight="Bold" />
                                    <ComboBox x:Name="RingtoneComboBox" DisplayMemberPath="Name" Margin="0,5,0,12" />
                                    <TextBlock Text="Video source" Foreground="#64748B" FontWeight="Bold" />
                                    <ComboBox x:Name="VideoSourceComboBox" Margin="0,5,0,18" />
                                    <Button Content="Save devices" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="SaveDevicesButton_Click" />
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsStatusTab" Header="Status">
                                <StackPanel>
                                    <Border Background="#EEF4FB" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" x:Name="ConnectionPill" Background="#FFF1D6" CornerRadius="8" Padding="12,8">
                                                    <TextBlock x:Name="ConnectionStatusText" Text="Connecting..." Foreground="#8A4F08" FontWeight="Black" />
                                                </Border>
                                                <TextBlock Text="Connection" Foreground="#111827" FontSize="18" FontWeight="Black" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="ServerStatusText" Text="Checking account connection." Foreground="#64748B" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Latency" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PingStatusText" Text="Not checked yet" Foreground="#111827" FontWeight="Bold" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AppVersionText" Text="-" Foreground="#111827" FontWeight="Bold" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Product" Foreground="#64748B" FontWeight="Bold" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProductIdText" Text="merlin-sip" Foreground="#111827" FontWeight="Bold" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Send error log" Style="{StaticResource SoftButton}" Click="SendErrorLogButton_Click" />
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SettingsUpdatesTab" Header="Updates">
                                <Border Background="#F8FBFE" BorderBrush="#D7E1EC" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" x:Name="CheckUpdatesButton" Content="Check for updates" Style="{StaticResource SoftButton}" Width="150" Click="CheckUpdatesButton_Click" />
                                            <TextBlock Text="Updates" Foreground="#111827" FontSize="18" FontWeight="Black" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="UpdateStatusText" Text="Version 1.0.5" Foreground="#64748B" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="UpdateNotesText" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="IncomingCallOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#9907111E">
            <Border Style="{StaticResource Surface}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Incoming call" FontSize="28" FontWeight="Black" Foreground="#111827" />
                    <TextBlock x:Name="IncomingCallerNameText" Text="Unknown caller" FontSize="22" FontWeight="Black" Foreground="#0E987E" Margin="0,18,0,2" TextWrapping="Wrap" />
                    <TextBlock x:Name="IncomingCallerNumberText" Text="" FontSize="15" FontWeight="Bold" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="Merlin SIP is ringing this extension." Foreground="#64748B" Margin="0,18,0,20" TextWrapping="Wrap" />
                    <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Answer" Style="{StaticResource SoftButton}" Background="{StaticResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0" Click="AnswerIncomingCallButton_Click" />
                        <Button Grid.Column="1" Content="Decline" Style="{StaticResource SoftButton}" Background="{StaticResource DangerBrush}" Foreground="White" Click="DeclineIncomingCallButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
