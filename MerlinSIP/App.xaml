<Application x:Class="MerlinSip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
        <Application.Resources>
        <Color x:Key="InkColor">#111316</Color>
        <Color x:Key="MutedColor">#736f68</Color>
        <Color x:Key="PanelColor">#f8f3ea</Color>
        <Color x:Key="LineColor">#D1D3D6</Color>
        <Color x:Key="TealColor">#18c7d8</Color>
        <Color x:Key="NightColor">#17191d</Color>
        <Color x:Key="OrangeColor">#ffb32c</Color>
        <Color x:Key="CoralColor">#ff5b4a</Color>
        <Color x:Key="GreenColor">#b7f55a</Color>
        <Color x:Key="WhiteColor">#fffaf2</Color>

        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
        <SolidColorBrush x:Key="NightBrush" Color="{StaticResource NightColor}" />
        <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
        <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
        <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />

        <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#fffaf2" Offset="0" />
            <GradientStop Color="#f8f3ea" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffd26b" Offset="0" />
            <GradientStop Color="#ffb32c" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ff7a6d" Offset="0" />
            <GradientStop Color="#ff5b4a" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="PanelShadow" BlurRadius="22" ShadowDepth="7" Opacity="0.10" Color="#111316" />
        <DropShadowEffect x:Key="RaisedShadow" BlurRadius="14" ShadowDepth="4" Opacity="0.12" Color="#111316" />
        <DropShadowEffect x:Key="BrutalShadow" BlurRadius="0" ShadowDepth="4" Opacity="1.0" Color="#111316" Direction="315" />
        <DropShadowEffect x:Key="BrutalShadowHover" BlurRadius="0" ShadowDepth="2" Opacity="1.0" Color="#111316" Direction="315" />

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource OrangeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="0" ShadowDepth="4" Opacity="1.0" Color="#111316" Direction="315" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#ffd26b" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="2" Y="2" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="2" Opacity="1.0" Color="#111316" Direction="315" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="4" Y="4" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="1.0" Color="#111316" Direction="315" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGradientBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
        </Style>

        <Style x:Key="MiniPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect" Value="{StaticResource RaisedShadow}" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFCFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFCFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FBFCFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Margin="12,0,42,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False" />
                                    <Path x:Name="Arrow"
                                          Width="10"
                                          Height="6"
                                          Margin="0,0,16,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource MutedBrush}"
                                          Data="M 0 0 L 5 6 L 10 0 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,6,0,0"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.16" Color="#172033" />
                                    </Border.Effect>
                                    <ScrollViewer Padding="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#AFC2D8" />
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TealBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource TealBrush}" />
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TealBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#DFF8EE" />
                                <Setter Property="Foreground" Value="#0F513F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
