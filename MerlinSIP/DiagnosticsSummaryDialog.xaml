<Window x:Class="MerlinSip.DiagnosticsSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Diagnostics" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CurrentTestText" Grid.Row="0" Text="Preparing diagnostics..." FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer x:Name="LogsScrollViewer">
                <TextBlock x:Name="LogsText" TextWrapping="Wrap" FontFamily="Consolas" Padding="5" />
            </ScrollViewer>
        </Border>

        <Button x:Name="CloseBtn" Grid.Row="2" Content="Close" Width="100" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right" Click="CloseButton_Click" />
    </Grid>
</Window>
