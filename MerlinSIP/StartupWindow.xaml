<Window x:Class="MerlinSip.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merlin SIP Setup"
        Width="560"
        Height="640"
        MinWidth="520"
        MinHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Grid Margin="24">
        <Border Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <Border Width="54"
                            Height="54"
                            CornerRadius="8"
                            Background="#2DD4BF"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <TextBlock Text="MS"
                                   Foreground="#101622"
                                   FontWeight="Black"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Merlin SIP"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="30"
                               FontWeight="Black" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Enter your license key to unlock setup."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="LicenseStepPanel">
                            <TextBlock Text="License key" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBox x:Name="LicenseKeyTextBox"
                                     Text="TEST-MERLIN-SIP"
                                     Margin="0,6,0,8"
                                     CharacterCasing="Upper" />
                            <TextBlock Text="Use TEST-MERLIN-SIP while the accounts module activation endpoint is being built."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="CredentialsStepPanel" Visibility="Collapsed">
                            <TextBlock Text="SIP server" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBox x:Name="ServerTextBox" Margin="0,6,0,12" ToolTip="Example: 192.168.1.10 or sip.company.local" />

                            <TextBlock Text="SIP port" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBox x:Name="PortTextBox" Text="5060" Margin="0,6,0,12" />

                            <TextBlock Text="SIP domain / realm" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBox x:Name="DomainTextBox" Margin="0,6,0,12" ToolTip="Leave blank to use the SIP server." />

                            <TextBlock Text="Extension" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBox x:Name="ExtensionTextBox" Text="1001" Margin="0,6,0,12" />

                            <TextBlock Text="Auth username" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBox x:Name="UsernameTextBox" Margin="0,6,0,12" />

                            <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <PasswordBox x:Name="PasswordBox" Margin="0,6,0,12" />

                            <TextBlock Text="Audio input" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <ComboBox x:Name="AudioInputComboBox" Margin="0,6,0,12" />

                            <TextBlock Text="Audio output" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <ComboBox x:Name="AudioOutputComboBox" Margin="0,6,0,12" />

                            <TextBlock Text="Video source" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <ComboBox x:Name="VideoSourceComboBox" Margin="0,6,0,12" />
                        </StackPanel>

                        <TextBlock x:Name="ErrorText"
                                   Foreground="#B82F2F"
                                   FontWeight="Bold"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            x:Name="ContinueButton"
                            Content="Continue"
                            Background="{StaticResource TealBrush}"
                            Foreground="White"
                            Click="ContinueButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
